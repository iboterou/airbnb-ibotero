--Which individual host, a person rather than a company, has the most listings?
SELECT host_name, COUNT(id) AS listing_count
FROM listings
WHERE host_name NOT LIKE '%LLC%'
  AND host_name NOT LIKE '%Inc%'
  AND host_name NOT LIKE '%Holdings%'
  AND host_name NOT LIKE '%Rentals%'
  AND host_name NOT LIKE '%Club%'
  AND host_name NOT LIKE '%Management%'
  AND host_name NOT LIKE '%Hospitality%'
  AND host_name NOT LIKE '%Properties%'
  AND host_name NOT LIKE '%Concierge%'
GROUP BY host_name
ORDER BY listing_count DESC
LIMIT 10;
--Verdict: I do trust this because it removed words that are commonly associated with comapnies to narrow it down. The Limit 10 was good (instead of limit 1) because the #1 was still a company that just did not include any of the other key terms.
