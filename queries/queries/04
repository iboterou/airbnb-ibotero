--Which 5 Chicago neighborhoods have the highest number of short-term rentals, and what is the average nightly price in those areas?
SELECT neighborhood, COUNT(id) AS total_listings, ROUND(AVG(price), 2) AS average_price
FROM listings
GROUP BY neighborhood
ORDER BY total_listings DESC
LIMIT 5;
